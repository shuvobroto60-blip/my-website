{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "has": [
        { "type": "host", "value": "tracknest-live-.*\\.vercel\\.app" }
      ],
      "dest": "https://backend-pink-gamma-15.vercel.app/api/$1"
    },
    { "handle": "filesystem" }
  ]
}
